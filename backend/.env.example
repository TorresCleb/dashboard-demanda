# Porta onde a API vai rodar
PORT=3000

# Google Gemini — obtenha a chave em https://aistudio.google.com/apikey
# Se omitida ou vazia, o sistema usa apenas classificação local (palavras-chave).
GEMINI_API_KEY=

# Modelo opcional (padrão: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Chave de autenticação do Evolution API (a mesma do docker-compose.yml)
EVOLUTION_API_KEY=minha-chave-secreta-123
